# Copy this file to .env.local for local dev (DO NOT commit real values)
# On Vercel: add these as Sensitive environment variables in Project Settings

# The real CTF flag. Only served on the "won" event from /api/talk.
BAAZI_FLAG=KCTF{replace-with-your-private-flag}

# Random string (32+ chars) used to HMAC-sign the session cookie.
SESSION_SECRET=change-me-to-32+-random-chars
